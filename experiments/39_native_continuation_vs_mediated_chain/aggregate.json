{
  "experiment": "exp39_native_continuation_vs_mediated_chain",
  "kind": "curated_summary",
  "schema": "rayx-exp39-decomposition-1",
  "schema_note": "experiment-local; NOT the v1 benchmark JSONL schema",
  "observation_only": true,
  "machine_specific": true,
  "framing": "decomposition, not 'HPX wins'. A linear DEPENDENT chain has no parallelism and is the least-flattering shape for HPX; this slice measures WHERE the cost goes (repeated Python/pybind/RuntimeFuture/lane boundary cost vs scheduled hpx::future::then continuation/shared-state cost), not who wins. The overlap/concurrency story is the separate exp40.",
  "supported_claim": "For dependent synthetic native work inside one RayX runtime, in-process native composition avoids repeated Python/pybind/RuntimeFuture/lane-boundary cost. The scheduled hpx::future::then variant measures the HPX continuation/shared-state overhead paid to express the chain natively.",
  "non_claims": [
    "no Ray-mediated baseline",
    "no multi-node result",
    "no HPX fabric / parcelport / AGAS",
    "no Python callback result",
    "no tokenizer / detokenization / vLLM / SGLang result",
    "no no-GIL result",
    "no general 'HPX beats Ray' claim",
    "no real model inference; chain work is synthetic masked on-core int64 work"
  ],
  "decomposition_legend": {
    "mediated_minus_loop": "repeated boundary overhead = (S-1) extra submit/retire cycles (pybind marshal + GIL cycle + RuntimeFuture alloc + lane admission + dispatch hop)",
    "then_minus_loop": "scheduled hpx::future::then continuation / shared-state overhead (launch::async, deliberately visible/pessimistic; NOT the HPX floor)",
    "mediated_minus_then": "net benefit of staying native while still paying HPX continuation cost"
  },

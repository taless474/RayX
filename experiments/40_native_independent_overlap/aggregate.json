{
  "experiment": "exp40_native_independent_overlap",
  "kind": "curated_summary",
  "schema": "rayx-exp40-overlap-1",
  "schema_note": "experiment-local; NOT the v1 benchmark JSONL schema",
  "observation_only": true,
  "machine_specific": true,
  "framing": "fixed-core independent-chain overlap inside ONE RayX runtime. Arm A = RayX lane-level baseline/control (K independent chain_sum_loop submissions; K outer hpx::async hops + K Python/pybind/RuntimeFuture retirements). Arm B = HPX-native intra-op overlap (one chain_fanout op; K children via bare hpx::async + when_all; 1 outer retirement, no inter-child Python retirement) -- the LOAD-BEARING arm. Primary metric is fixed-core overlap_ratio = K*T1/TK (hpx_threads held constant), NOT a thread-count speedup.",
  "supported_claim": "Arm B demonstrates HPX-native intra-op overlap of independent native work inside one RayX runtime under this synthetic CPU workload: near-ideal up to ~4 effective workers, saturating below ideal at 8. Arm B is stronger than Arm A across the whole primary matrix.",
  "characterized_limitations": {
    "k8_dip": "At K=8 (== worker count) overlap saturates below ideal (efficiency ~0.5-0.74, deepest at q=16384) -- NOT a failure.",
    "t4_to_t8_stall": "Secondary sweep (K=8,q=16384): Arm B overlap 4.20 at T=4 (eff 1.05) but 4.28 at T=8 (eff 0.54); wall 1.639->1.634 ms -- workers 5-8 buy nothing. Effective parallelism ceilings ~4 for this op/workload.",
    "fine_grain": "At q=256 per-chain work (~0.05 ms) ~ scheduling/boundary overhead, so ratios are amortization-inflated (eff>1 is an artifact); clean compute-overlap read is q=16384/65536.",
    "binding": "RayX passes only --hpx:threads; binding is HPX default; placement unknown. NO NUMA/socket attribution. The T=4->T=8 stall could be placement- or scheduler-bound; not resolved here."
  },
  "non_claims": [
    "no Ray-mediated baseline (Arm A is RayX-internal lane routing, not Ray)",
    "no multi-node evidence",
    "no Ray transport evidence",
    "no HPX fabric / parcelport / AGAS evidence",
    "no Python-callback evidence",
    "no tokenizer / vLLM / SGLang / Ray Serve / real inference evidence",
    "no no-GIL evidence",
    "no general 'HPX beats Ray' claim"
  ],
  "commit": "c1496875118f0c4d1d257151a6f02b8a085e6a86",
